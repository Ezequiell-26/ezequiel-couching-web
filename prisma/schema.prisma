// Esquema recreado tras incidente de pérdida del workspace (Task 22-a).
// Arranca VACÍA: sin datos inventados. Compatibilidad de nombres con la
// arquitectura documentada (leads, intakes, messages, orders, products, plans, posts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  email     String
  name      String?
  source    String   @default("guia-gratis")
  createdAt DateTime @default(now())
}

model Intake {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  age          Int?
  sex          String? // hombre | mujer
  heightCm     Float?
  weightKg     Float?
  goal         String?
  experience   String?
  daysPerWeek  Int?
  equipment    String?
  injuries     String?
  message      String?
  status       String   @default("nuevo")
  createdAt    DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  body      String
  read      Boolean  @default(false)
  reply     String?
  createdAt DateTime @default(now())
}

model Order {
  id            Int      @id @default(autoincrement())
  number        String   @unique
  kind          String   @default("producto") // producto | plan
  itemSlug      String
  itemName      String
  amountCents   Int
  customerName  String
  customerEmail String
  status        String   @default("pendiente") // pendiente | pagado | entregado | cancelado
  provider      String   @default("manual") // manual | stripe
  providerRef   String?
  createdAt     DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String
  category    String   @default("programa")
  priceCents  Int
  fileName    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Plan {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  level      String   @default("iniciacion")
  weeks      Int      @default(8)
  summary    String
  priceCents Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String
  body      String
  category  String   @default("general")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────
// Zona de entrenamiento del cliente (Task 24) — SOLO ADITIVO:
// no modifica ninguna tabla existente. Persistencia real para
// rutinas, sesiones, peso, agua, hábitos, PRs y logros.
// ─────────────────────────────────────────────────────────────────

model ClientProfile {
  id            Int       @id @default(autoincrement())
  name          String
  pinHash       String // scrypt(salt + pin), nunca el PIN en claro
  sessionToken  String?   @unique
  sessionExpiry DateTime?
  createdAt     DateTime  @default(now())

  // Metas personales opcionales (Task 26-a): null = sin meta definida.
  weightGoalKg Float?
  waterGoalMl  Int?

  routines   Routine[]
  sessions   WorkoutSession[]
  weightLogs WeightLog[]
  waterLogs  WaterLog[]
  habitLogs  HabitLog[]
  weekSlots  WeekSlot[]
}

model Routine {
  id          Int      @id @default(autoincrement())
  profileId   Int
  profile     ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  goal        String   @default("general") // general | hipertrofia | fuerza | perder-grasa | resistencia
  level       String   @default("principiante") // principiante | intermedio | avanzado
  daysPerWeek Int      @default(3)
  equipment   String   @default("gimnasio") // gimnasio | mancuernas | casa | peso-corporal
  source      String   @default("manual") // manual | ia
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    RoutineItem[]
  sessions WorkoutSession[]
  weekSlots WeekSlot[]

  @@index([profileId])
}

model RoutineItem {
  id         Int     @id @default(autoincrement())
  routineId  Int
  routine    Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  day        Int     @default(1) // día 1..N de la rutina
  orderIdx   Int     @default(0)
  exerciseId String // id del ejercicio en la biblioteca (src/lib/content/exercises.ts)
  sets       Int     @default(3)
  reps       String  @default("10-12")
  restSec    Int     @default(90)
  notes      String?

  @@index([routineId])
}

model WorkoutSession {
  id         Int       @id @default(autoincrement())
  profileId  Int
  profile    ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  routineId  Int?
  routine    Routine?  @relation(fields: [routineId], references: [id])
  title      String
  day        Int?
  status     String    @default("activa") // activa | completada
  volumeKg   Float     @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  sets SetLog[]

  @@index([profileId])
}

model SetLog {
  id         Int            @id @default(autoincrement())
  sessionId  Int
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  setNumber  Int
  weightKg   Float?
  reps       Int
  rpe        Int?
  createdAt  DateTime       @default(now())

  @@index([sessionId])
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime // normalizado a medianoche UTC
  kg        Float

  @@unique([profileId, date])
  @@index([profileId])
}

model WaterLog {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime // normalizado a medianoche UTC
  ml        Int

  @@unique([profileId, date])
  @@index([profileId])
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime // normalizado a medianoche UTC
  habit     String // sueno | proteina | agua | pasos | estiramiento | sin-azucar
  done      Boolean  @default(false)

  @@unique([profileId, date, habit])
  @@index([profileId])
}

// Plan semanal del cliente (Task 25-b): asignación de rutina/día por día de
// la semana. SOLO ADITIVO: no modifica ninguna tabla existente.
model WeekSlot {
  id        String        @id @default(cuid())
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int
  weekday   Int // 0=Lunes .. 6=Domingo
  routine   Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineId Int?
  day       Int? // día de la rutina asignado (1..daysPerWeek)
  createdAt DateTime      @default(now())

  @@unique([profileId, weekday])
  @@index([profileId])
}

// ─────────────────────────────────────────────────────────────────
// NUEVAS FEATURES (Task 50+): Gamificación avanzada, comunidad,
// fotos progreso, sleep tracker, challenges, meal planner, notificaciones
// ─────────────────────────────────────────────────────────────────

// Challenges mensuales con objetivos y rankings
model Challenge {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  type        String      // steps | workout | water | habit
  target      Int
  startDate   DateTime
  endDate     DateTime
  active      Boolean     @default(true)
  participants Int        @default(0)
  createdAt   DateTime    @default(now())
  
  entries     ChallengeEntry[]
}

model ChallengeEntry {
  id          Int       @id @default(autoincrement())
  challengeId Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profileId   Int
  profile     ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value       Int       @default(0)
  rank        Int?
  completed   Boolean   @default(false)
  updatedAt   DateTime  @default(now())

  @@unique([challengeId, profileId])
  @@index([challengeId])
  @@index([profileId])
}

// Fotos de progreso del cliente
model ProgressPhoto {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  type      String    // front | back | side | comparison
  notes     String?
  takenAt   DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([profileId])
}

// Tracker de sueño
model SleepLog {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime  // fecha de la noche
  hours     Float
  quality   Int?      // 1-5 escala
  notes     String?
  createdAt DateTime  @default(now())

  @@unique([profileId, date])
  @@index([profileId])
}

// Meal planner / planificador de comidas
model MealPlan {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  calories  Int?
  protein   Int?
  carbs     Int?
  fats      Int?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  meals     Meal[]
}

model Meal {
  id        Int       @id @default(autoincrement())
  mealPlanId Int
  mealPlan  MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  name      String
  type      String    // desayuno | almuerzo | cena | snack
  calories  Int?
  protein   Int?
  carbs     Int?
  fats      Int?
  recipe    String?
  ingredients String?
  orderIdx  Int       @default(0)

  @@index([mealPlanId])
}

// Comunidad / posts de usuarios
model CommunityPost {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   String
  images    String?   // URLs separadas por coma
  likes     Int       @default(0)
  comments  Int       @default(0)
  tags      String?   // tags separados por coma
  createdAt DateTime  @default(now())

  @@index([profileId])
}

// Notificaciones push
model Notification {
  id        Int       @id @default(autoincrement())
  profileId Int?
  profile   ClientProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String    // reminder | achievement | challenge | general
  read      Boolean   @default(false)
  data      String?   // JSON con datos extra
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
}

// Exportaciones generadas
model Export {
  id        Int       @id @default(autoincrement())
  profileId Int
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String    // routines | progress | workouts | nutrition
  format    String    // pdf | csv | json | ics
  url       String?
  status    String    @default(\"pending\") // pending | ready | expired
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
}
